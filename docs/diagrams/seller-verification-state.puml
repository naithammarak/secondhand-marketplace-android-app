@startuml
!pragma layout smetana
title Seller Verification State Diagram - Prototype/Core

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Leelawadee UI"
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #475569
skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}

state "NOT_SUBMITTED\nยังไม่ส่งคำขอ" as NOT_SUBMITTED
state "PENDING\nรอผู้ดูแลตรวจสอบ" as PENDING #FFF7E6
state "APPROVED\nอนุมัติแล้ว" as APPROVED #EAF7ED
state "REJECTED\nถูกปฏิเสธ" as REJECTED #FDECEC

[*] --> NOT_SUBMITTED : ผู้ใช้เลือกบทบาท SELLER

NOT_SUBMITTED --> PENDING : ส่งข้อมูลสมมติและรูปเอกสาร\n[Role = SELLER และ UserStatus = ACTIVE]\n/ สร้าง SellerVerification

PENDING --> APPROVED : Admin อนุมัติ\n[สถานะปัจจุบัน = PENDING]\n/ ตั้ง reviewedAt, verifiedAt และผู้ตรวจ

PENDING --> REJECTED : Admin ปฏิเสธพร้อมเหตุผล\n[สถานะปัจจุบัน = PENDING]\n/ ตั้ง reviewedAt, rejectReason และผู้ตรวจ

REJECTED --> PENDING : Seller แก้ข้อมูลและส่งใหม่\n[Role = SELLER และ UserStatus = ACTIVE]\n/ สร้าง SellerVerification แถวใหม่

APPROVED --> [*] : มีสิทธิ์เรียก API ลงขายสินค้า

note right of NOT_SUBMITTED
  NOT_SUBMITTED เป็นสถานะสำหรับ API/UI
  เมื่อยังไม่มี SellerVerification
  ไม่ใช่ค่าที่บันทึกในฐานข้อมูล
end note

note right of REJECTED
  คำขอเดิมยังอยู่เป็นประวัติ
  Database อนุญาต PENDING
  ได้ครั้งละหนึ่งแถวต่อ Seller
end note

note right of APPROVED
  Seller.isVerified เป็น derived value
  จาก status = APPROVED
  และไม่มีวันหมดอายุใน Prototype
end note

legend bottom
  |= สี |= ความหมาย |
  |<#F8FAFC> | ยังไม่เริ่ม |
  |<#FFF7E6> | รอตรวจสอบ |
  |<#EAF7ED> | อนุมัติและลงขายได้ |
  |<#FDECEC> | ปฏิเสธและแก้ไขส่งใหม่ได้ |
endlegend

@enduml
