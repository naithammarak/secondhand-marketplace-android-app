{
  "name": "2NDHAND Marketplace",
  "androidPackage": "com.kmutnb.secondhandmarketplace",
  "scheme": "secondhandmarketplace",
  "expoSdkVersion": "57.0.0",
  "routerRoot": "src/app",
  "previewProfile": {
    "distribution": "internal",
    "environment": "preview",
    "android": {
      "buildType": "apk"
    },
    "env": {
      "EXPO_PUBLIC_PRODUCT_CATALOG_ENV": "preview",
      "EXPO_PUBLIC_PRODUCT_CATALOG_MODE": "api",
      "EXPO_PUBLIC_ORDER_DIRECT_ID_ENTRY": "false"
    }
  },
  "credentialsRecorded": false
}
