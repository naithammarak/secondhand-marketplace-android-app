@startuml
!pragma layout smetana
title 2NDHAND - submission target classes (1 Oct 2026)
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
skinparam shadowing false
hide empty methods
hide circle

package "Identity and catalog" {
  class User {
    id : int
    full_name : String
    email : String [private]
    role : BUYER/SELLER/INSPECTOR/COURIER/ADMIN
    status : ACTIVE/SUSPENDED/CLOSED
    privacy_policy_version : String?
    privacy_acknowledged_at : UTC?
  }
  class SellerVerification {
    status : verification status
    private_evidence : protected reference
  }
  class Product {
    id : int
    seller_id : int
    status : product status
    item_price : Decimal
    sale_type : FIXED_PRICE
  }
  class ProductImage
}
package "Orders and money" {
  class Order {
    id : int
    buyer_id / seller_id / product_id : int
    status : OrderStatus
    buyer_address_snapshot : immutable
    seller_return_snapshot : frozen before shipment
    item / shipping / inspection / commission : Decimal snapshots
    paid_at : UTC?
    receipt_deadline_at : UTC?
  }
  class Payment {
    status : historical successful charge
    amount : Decimal
  }
  class Receipt {
    payment_id : unique
    immutable : true
  }
  class Escrow {
    held_amount : Decimal
    state : HELD/RELEASED/REFUNDED
  }
  class OrderSettlement {
    order_id : unique
    escrow_id : unique
    kind : RELEASE/REFUND
    recipient : server derived
    payout / refund / allocations : Decimal
    settled_at : UTC
  }
  class CommandRecord {
    actor / action / resource / key : unique
    canonical_payload_hash : String
  }
  class OrderHistory
  class ReceiptConfirmation
  class NonReceiptReport
  class AuditLog
}
package "Delivery and inspection" {
  class Shipment {
    leg : TO_CENTER/TO_BUYER/TO_SELLER
    assigned_courier_id : int
    destination : immutable snapshot
    confirmed_delivery_at : UTC?
  }
  class DeliveryProof {
    object_key : private
    content_hash / mime / size : verified
    selected_at_confirmation : frozen
  }
  class Inspection {
    assigned_inspector_id : int
    result : PASS/MINOR_ISSUE/NOT_AS_DESCRIBED/FAKE
    overdue_escalated_at : UTC?
  }
  class InspectionPhoto
  class BuyerInspectionDecision {
    order_id : unique
    decision : CONFIRM/REJECT
  }
  class Certificate {
    inspection_id : unique
    public_token : opaque unique
    status : ISSUED/REVOKED
    issued_at / revoked_at : UTC
    revoke_reason : private audit
  }
}
class Review {
  order_id : unique
  buyer_id / seller_id / product_id : derived
  rating : int [1..5]
  comment : String [0..1000]
  created_at : UTC
}

User "1" -- "0..1" SellerVerification : applies
User "1" -- "0..*" Product : seller capability
Product "1" *-- "0..10" ProductImage
User "1" -- "0..*" Order : buyer/seller capability
Product "1" -- "0..*" Order
Order "1" -- "0..*" Payment
Payment "1" -- "0..1" Receipt
Order "1" -- "0..1" Escrow
Order "1" -- "0..1" OrderSettlement
Escrow "1" -- "0..1" OrderSettlement
Payment "1" -- "0..1" OrderSettlement : original charge reference
Order "1" -- "0..*" CommandRecord
Order "1" -- "0..*" OrderHistory
Order "1" -- "0..1" ReceiptConfirmation
Order "1" -- "0..1" NonReceiptReport
User "1" -- "0..*" AuditLog
Order "1" -- "0..2" Shipment
Shipment "1" *-- "0..3" DeliveryProof
User "1" -- "0..*" Shipment : assigned courier
Order "1" -- "0..1" Inspection
Inspection "1" *-- "0..*" InspectionPhoto
Inspection "1" -- "0..1" BuyerInspectionDecision
Inspection "1" -- "0..1" Certificate
Order "1" -- "0..1" Review
User "1" -- "0..*" Review : actual buyer / rated seller

note bottom of User
  One role field; new users are BUYER.
  Approved SELLER retains Buyer actions.
  No disjoint Buyer/Seller subclasses or client staff selector.
end note
note bottom of OrderSettlement
  Exactly one RELEASE or REFUND, never both.
  Original successful Payment/Receipt remain unchanged.
  Wallet, bank withdrawal and provider transfers are deferred.
end note
note bottom of Certificate
  Atomic issue with PASS/MINOR_ISSUE before Buyer decision.
  Revocation changes certificate validity, not settlement.
end note
legend bottom
  Target logical design, not proof that baseline implements every class.
  Task 02 maps these concepts to existing physical models/routes.
endlegend
@enduml
