DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@SESSION_POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=
# Needed only for legacy HS256 signing keys.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
# Set this to the active signing algorithm, or leave blank during key rotation.
SUPABASE_JWT_ALGORITHM=
