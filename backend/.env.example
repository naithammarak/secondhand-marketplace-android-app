DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@SESSION_POOLER_HOST:5432/postgres
PUBLIC_CERTIFICATE_BASE_URL=https://YOUR_PUBLIC_API_ORIGIN
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=
# Needed only for legacy HS256 signing keys.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
# Set this to the active signing algorithm, or leave blank during key rotation.
SUPABASE_JWT_ALGORITHM=

# Private bucket that stores seller ID card images uploaded through the API.
# The service role key stays on the server and must never reach the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VERIFICATION_BUCKET=seller-verifications

# Order payment simulation (ORDER-03). Closed unless explicitly enabled, and always closed
# when APP_ENV is production/prod. Enable only for demo/test environments.
APP_ENV=development
PAYMENT_SIMULATION_ENABLED=false

# FINISH prototype only; unknown/production APP_ENV always refuses mutations.
FULFILLMENT_SIMULATION_ENABLED=false

# Explicit Admin-only simulated transport events; no real carrier integration.
EXTERNAL_SHIPPING_DEMO_ENABLED=false
