# Public client configuration; obtain test values from BE/Lead through the team channel.
# Supabase values are used by LOGIN-01; product catalog settings are used by PRODUCT-07.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set `api` with EXPO_PUBLIC_API_BASE_URL for backend data; `mock` is development/test data only.
EXPO_PUBLIC_PRODUCT_CATALOG_ENV=development
EXPO_PUBLIC_PRODUCT_CATALOG_MODE=mock
EXPO_PUBLIC_API_BASE_URL=
# Development only: set true to use in-memory product and upload mocks.
# This flag is ignored by production/release builds.
EXPO_PUBLIC_PRODUCT_MOCK_MODE=false
# Redirect is fixed in code: secondhandmarketplace://auth/callback
# Never add Google client secrets, service-role keys or session tokens.
