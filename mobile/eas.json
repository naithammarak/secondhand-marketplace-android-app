{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_PRODUCT_CATALOG_ENV": "development",
        "EXPO_PUBLIC_PRODUCT_CATALOG_MODE": "mock"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_PRODUCT_CATALOG_ENV": "preview",
        "EXPO_PUBLIC_PRODUCT_CATALOG_MODE": "api"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_PRODUCT_CATALOG_ENV": "production",
        "EXPO_PUBLIC_PRODUCT_CATALOG_MODE": "api"
      }
    }
  }
}
